# Keep Windows checkouts compatible with Prettier and the original source hashes.
* text=auto eol=lf
*.png binary
*.webp binary
*.avif binary
*.woff binary
*.woff2 binary

# Preserve exact imported provenance bytes as well as image hashes across workstations.
docs/visuals/external-edit/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
