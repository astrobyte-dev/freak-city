      "denoise": 1.0,
      "model": ["4", 0],
      "positive": ["11", 0],
      "negative": ["8", 0],
      "latent_image": ["9", 0]
    },
    "_meta": {
      "title": "Fixed seed 19421 / 20 steps / batch 1"
