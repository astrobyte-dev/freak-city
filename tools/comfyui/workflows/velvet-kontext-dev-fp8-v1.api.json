    "_meta": {
      "title": "Embedded guidance 2.5"
    }
  },
  "12": {
    "class_type": "KSampler",
    "inputs": {
      "seed": 19421,
      "steps": 20,
      "cfg": 1.0,
      "sampler_name": "euler",
